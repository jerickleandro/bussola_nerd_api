# Ambiente
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bussola_nerd

# JWT
JWT_SECRET=coloque-aqui-uma-chave-bem-grande-e-secreta
JWT_EXPIRES_IN=1h

# Spotify
SPOTIFY_CLIENT_ID=seu_client_id
SPOTIFY_CLIENT_SECRET=seu_client_secret
SPOTIFY_SHOW_ID=seu_show_id_podcast
PODCAST_FEED_URL=https://anchor.fm/s/c64d550/podcast/rss

# TheMovieDB (lançamentos de filmes)
RELEASES_API_BASE_URL=https://api.themoviedb.org/3
RELEASES_API_KEY=seu_bearer_token_themoviedb

# Serviço de scrap (integração interna)
SCRAP_API_KEY=chave_super_secreta_scrap
SCRAP_CRON=0 */12 * * *

# LLM (AI Gateway -> tradução + resumo)
LLM_PROVIDER=openrouter
LLM_API_KEY=sua_api_key_openrouter
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
